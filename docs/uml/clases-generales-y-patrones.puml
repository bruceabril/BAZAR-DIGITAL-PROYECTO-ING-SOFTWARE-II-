@startuml
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

package "domain.model" {
  abstract class Producto {
    - id: String
    - nombre: String
    - precio: double
    - stock: int
    + getPrecio(): double
    + getStock(): int
    + actualizarStock(nuevoStock: int): void
    + agregarObservadorStock(observador): void
  }
  class ProductoFisico
  class ProductoDigital
  class ComboBazar
  class Carrito
  class LineaCarrito
  class Cliente
  class Pedido {
    - estado: EstadoPedido
    + cambiarEstado(nuevoEstado: EstadoPedido): void
  }
  enum EstadoPedido {
    CREADO
    CONFIRMADO
    CANCELADO
  }
  class Factura
  interface ModalidadEntrega
  class EntregaDomicilio
  class EntregaRetiro
  class EntregaDigital
}

package "domain.observer" {
  interface ObservadorStock {
    + alCambiarStock(producto, anterior, nuevo): void
  }
  interface ObservadorPedido {
    + alCambiarEstado(pedido, anterior, nuevo): void
  }
}

package "domain.decorator" {
  abstract class ProductoDecorado
  class GarantiaExtendida
  class EmpaqueRegalo
  class EnvioExpress
}

package "domain.factory" {
  abstract class FabricaProducto
  class FabricaProductoFisico
  class FabricaProductoDigital
  class FabricaComboBazar
  abstract class CreadorPedido
  class CreadorPedidoDigital
  class CreadorPedidoDomicilio
  class CreadorPedidoRetiro
}

package "domain.strategy" {
  interface EstrategiaDescuento
  class DescuentoPorCantidad
  class DescuentoTemporada
  class DescuentoClienteFrecuente
  class DescuentoCupon
  class CalculadoraDescuentos
  interface EstrategiaPago
  class PagoTarjeta
  class PagoTransferencia
  class PagoContraEntrega
}

package "repository" {
  interface ProductoRepository
  class InMemoryProductoRepository
  interface PedidoRepository
  class InMemoryPedidoRepository
}

package "service" {
  class ServicioCarrito
  class ServicioInventario
  class ServicioCheckout
}

package "ui" {
  class BazarDigitalApp
  class AplicacionConsola
  class AplicacionGrafica
}

Producto <|-- ProductoFisico
Producto <|-- ProductoDigital
Producto <|-- ComboBazar
Producto <|-- ProductoDecorado
ProductoDecorado <|-- GarantiaExtendida
ProductoDecorado <|-- EmpaqueRegalo
ProductoDecorado <|-- EnvioExpress
ProductoDecorado o--> Producto : envuelve
Producto --> ObservadorStock : notifica

Carrito *-- "0..*" LineaCarrito
LineaCarrito --> Producto
ComboBazar o--> "0..*" Producto : incluye
Pedido --> Cliente
Pedido o--> "1..*" Producto
Pedido --> ModalidadEntrega
Pedido --> EstadoPedido
Pedido --> ObservadorPedido : notifica
Factura --> Pedido
ModalidadEntrega <|.. EntregaDomicilio
ModalidadEntrega <|.. EntregaRetiro
ModalidadEntrega <|.. EntregaDigital

FabricaProducto <|-- FabricaProductoFisico
FabricaProducto <|-- FabricaProductoDigital
FabricaProducto <|-- FabricaComboBazar
FabricaProducto ..> Producto : crea
CreadorPedido <|-- CreadorPedidoDigital
CreadorPedido <|-- CreadorPedidoDomicilio
CreadorPedido <|-- CreadorPedidoRetiro

EstrategiaDescuento <|.. DescuentoPorCantidad
EstrategiaDescuento <|.. DescuentoTemporada
EstrategiaDescuento <|.. DescuentoClienteFrecuente
EstrategiaDescuento <|.. DescuentoCupon
EstrategiaPago <|.. PagoTarjeta
EstrategiaPago <|.. PagoTransferencia
EstrategiaPago <|.. PagoContraEntrega

ProductoRepository <|.. InMemoryProductoRepository
PedidoRepository <|.. InMemoryPedidoRepository
ServicioCarrito --> ProductoRepository
ServicioInventario --> ProductoRepository
ServicioInventario ..> ObservadorStock
ServicioCheckout --> PedidoRepository
ServicioCheckout --> EstrategiaPago
ServicioCheckout ..> ObservadorPedido
ServicioCheckout ..> CalculadoraDescuentos
AplicacionConsola --> ServicioInventario
AplicacionConsola --> ServicioCheckout
AplicacionGrafica --> ServicioInventario
AplicacionGrafica --> ServicioCheckout
BazarDigitalApp ..> AplicacionConsola
BazarDigitalApp ..> AplicacionGrafica
@enduml
